# ============================================================================
# Docker Ignore — prevent sensitive files from entering the build context
# ============================================================================

# Git
.git
.gitignore
.gitattributes
.gitlab-ci.yml

# Build artifacts
target/
bin/
*.jar
*.war

# IDE / Editor
.idea/
.vscode/
*.iws
*.iml
*.ipr
*.launch

# OS files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Sensitive files — CRITICAL for security
.env
.env.*
!.env.example
*.env
.env.local
.env.*.local

# Certificates and keys
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.pub
*.crt

# Docker files
Dockerfile
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab/

# Documentation (not needed at runtime)
docs/
README.md

# Tests
src/test/

# Maven wrapper cache
.mvn/
mvnw
mvnw.cmd

# Logs
*.log
logs/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary
*.tmp
*.temp
*.swp
*.swo
*~
